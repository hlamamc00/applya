# Copy to .env and fill in. Only DATABASE_URL and AUTH_SECRET are required.

# Postgres connection string. Neon: the pooled URL for the app, the direct
# (unpooled) one for schema pushes.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.eu-west-2.aws.neon.tech/applya?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.eu-west-2.aws.neon.tech/applya?sslmode=require"

# Signs the login cookie. 32+ random characters: `openssl rand -base64 48`
AUTH_SECRET=""

# Absolute URL of the site, for links in emails.
SITE_URL="http://localhost:3000"

# Protects /api/scan and /api/apply/*, which the Netlify functions call.
CRON_SECRET=""

# Development only: a Chromium/Chrome binary so "Apply on their site" runs
# locally. On Netlify the apply-background function brings its own.
APPLY_CHROMIUM_PATH=""

# The first admin account, created by `npm run db:seed` when it doesn't exist.
SEED_ADMIN_EMAIL="hlamamc00@gmail.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"
SEED_ADMIN_FIRST_NAME="Hlamalani"
SEED_ADMIN_LAST_NAME="Chauke"

# AI (optional): tailoring, reading uploaded CVs. Set as many as you like:
# every provider with a key is queued, free tiers first (groq, gemini,
# openrouter, cloudflare) and anthropic last; when one hits its limit it
# rests and the next takes over. AI_PROVIDER sets the order (comma-separated).
# Without any key, drafts are tailored by keyword matching and CVs read by
# the section parser.
#
# Free to start:
#   Groq        console.groq.com → API Keys (free tier, fast Llama models)
#   Gemini      aistudio.google.com/app/apikey (free tier)
#   OpenRouter  openrouter.ai/keys (models ending ":free")
#   Cloudflare  dash.cloudflare.com → AI → Workers AI (free daily allowance)
GROQ_API_KEY=""
GEMINI_API_KEY=""
OPENROUTER_API_KEY=""
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_AI_TOKEN=""
# Paid:
ANTHROPIC_API_KEY=""
# Per-provider model overrides (defaults: llama-3.3-70b-versatile, gemini-2.5-flash,
# meta-llama/llama-3.3-70b-instruct:free, @cf/meta/llama-3.3-70b-instruct-fp8-fast, claude-opus-5-5).
GROQ_MODEL=""
GEMINI_MODEL=""
OPENROUTER_MODEL=""
CLOUDFLARE_AI_MODEL=""
ANTHROPIC_MODEL=""
AI_PROVIDER="groq,gemini,openrouter,cloudflare,anthropic"

# Email (optional). Account and review emails over SMTP; nothing is sent
# without these. Resend's relay: host smtp.resend.com, user "resend", pass = API key.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Applya <no-reply@applya.co.uk>"

# Job aggregators (optional). Public ATS boards (Greenhouse, Lever, Ashby,
# Workable), RSS feeds and the reed.co.uk feed need no keys.
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""
REED_API_KEY=""
# Google for Jobs (LinkedIn, Indeed, Glassdoor…) via JSearch on RapidAPI.
RAPIDAPI_KEY=""
JOOBLE_API_KEY=""
CAREERJET_API_KEY=""

# Web discovery of employer boards and feeds for a field (optional): Claude's
# web search uses ANTHROPIC_API_KEY above; Brave Search is an alternative
# (free tier at brave.com/search/api).
BRAVE_SEARCH_API_KEY=""

# Gmail / Outlook connections (optional; SMTP with an app password works
# without these). See the set-up notes at the top of src/lib/mail-oauth.ts.
# Redirect URIs: https://applya.co.uk/api/mail/google/callback and
# https://applya.co.uk/api/mail/microsoft/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
